# ==============================================================================
# FloodOps Chennai - Backend Environment Configuration Template
# ==============================================================================

PROJECT_NAME="FloodOps Chennai"
REGION_NAME="Chennai District, Tamil Nadu"
API_PREFIX="/api"

# Database Configuration (SQLite default; PostgreSQL with PostGIS optional)
DATABASE_URL="sqlite:///./floodops.db"
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/floodops_chennai"

# Security & Authentication
JWT_SECRET="replace-with-a-strong-secret-key"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# AI / LLM Configuration
# Options: "template" | "gemini" | "anthropic"
LLM_PROVIDER="template"
LLM_MODEL="gemini-2.5-flash"

# Optional LLM API Keys
# GEMINI_API_KEY="your-gemini-api-key"
# ANTHROPIC_API_KEY="your-anthropic-api-key"

# Multi-Agent Coordination Engine Settings
COORDINATOR_INTERVAL_SECONDS=30
AUTO_APPROVE=false
USE_REAL_FEEDS=false

# Chennai Hydrological Alert Thresholds
RIVER_ALERT_THRESHOLD_M=4.80
CENTER_LAT=13.0400
CENTER_LNG=80.2100
