# ==============================================================================
# FloodOps Chennai - Root Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND (backend/.env)
# ------------------------------------------------------------------------------
PROJECT_NAME="FloodOps Chennai"
REGION_NAME="Chennai District, Tamil Nadu"
API_PREFIX="/api"

# SQLite default database (or PostgreSQL + PostGIS connection string)
DATABASE_URL="sqlite:///./floodops.db"

# JWT Authentication
JWT_SECRET="floodops-super-secret-key-chennai-2026-secure-token"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120

# AI / LLM Configuration ("template" | "gemini" | "anthropic")
LLM_PROVIDER="template"
LLM_MODEL="gemini-2.5-flash"
# GEMINI_API_KEY="your-gemini-api-key"
# ANTHROPIC_API_KEY="your-anthropic-api-key"

COORDINATOR_INTERVAL_SECONDS=30
AUTO_APPROVE=false
USE_REAL_FEEDS=false

RIVER_ALERT_THRESHOLD_M=4.80
CENTER_LAT=13.0400
CENTER_LNG=80.2100

# ------------------------------------------------------------------------------
# FRONTEND (frontend/.env)
# ------------------------------------------------------------------------------
VITE_API_BASE="http://localhost:8000/api"
VITE_USE_MOCK=false
